# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────
# Public base URL, used for wallet pass links, Stripe redirects, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Calendly (or any scheduling link) for the "Réserver une démo" CTA on the
# public site. The button falls back to /signup if this is unset.
NEXT_PUBLIC_CALENDLY_URL=

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=

# ── Apple Wallet (PassKit) ───────────────────────────────────────────────
# Team ID from your Apple Developer account.
APPLE_TEAM_IDENTIFIER=
# Pass Type ID registered at developer.apple.com (e.g. pass.com.yourcompany.loyalty).
APPLE_PASS_TYPE_IDENTIFIER=
# Base64-encoded contents of the certificates listed in /certificates/README.md.
APPLE_WWDR_CERTIFICATE_BASE64=
APPLE_SIGNER_CERTIFICATE_BASE64=
APPLE_SIGNER_KEY_BASE64=
APPLE_SIGNER_KEY_PASSPHRASE=

# ── Google Wallet ─────────────────────────────────────────────────────────
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# Base64-encoded PEM private key from the service account JSON.
GOOGLE_WALLET_PRIVATE_KEY_BASE64=

# ── Email (Resend) ───────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. resend.dev works for testing
# without verifying your own domain.
EMAIL_FROM="Loyalty <onboarding@resend.dev>"

# ── Cron (inactivity + smart-engagement engines) ─────────────────────────
# Any random string. Vercel Cron automatically sends this as
# `Authorization: Bearer $CRON_SECRET` when it triggers /api/cron/* routes —
# set the same value here for local testing and on Vercel for production.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ── Weather (smart-engagement engine) ────────────────────────────────────
# https://openweathermap.org/api — free tier is enough. Optional: the
# arbitration engine skips the weather signal entirely if this is unset.
OPENWEATHER_API_KEY=

# ── POS ingestion (future integration landing zone) ──────────────────────
# Any random string — shared secret for /api/webhooks/pos, not yet connected
# to any real POS/Stripe product-level provider. Generate with: openssl rand -hex 32
POS_WEBHOOK_SECRET=
